        int tempo = 16;

        if (tempo < 12) {
            System.out.println("Boa noite!.");
        } else if (tempo < 18) {
            System.out.println("Bom dia!");
        } else {
            System.out.println("Boa tarde!.");
        }
        //Em Java, abreviação if...else (operador ternário)

