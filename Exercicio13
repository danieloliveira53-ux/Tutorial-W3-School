   public static void main(String[] args) {
        //Aplicação  iF e ELSE

        int x = 30;
        int y = 20;
        if (x > y) {

            System.out.println("verdadeiro");
        } else {
            System.out.println("Mentira");
        }
        boolean chuva = false;
        boolean sol = false;


        if (chuva) {
            System.out.println("Use o guarda chuva");
        } else if (sol) {
            System.out.println("Use o oculos escuros");
        } else {
            System.out.println("Pode sair normalmente");
