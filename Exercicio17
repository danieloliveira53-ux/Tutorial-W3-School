public class Exercicio18 {
    public static void main(String[] args) {

        //DESAFIO DE CODIGO SWITCH EM JAVA

        int escolha = 2;

        switch (escolha) {
            case 1:
                System.out.println("Você pediu café");
                break;
            case 2:
                System.out.println("Você pediu chá");
                break;
            default:
                System.out.println("Pedido invalido");
        }


    }
}
